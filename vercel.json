{
  "buildCommand": "node scripts/build-home-css.cjs --versioned && node scripts/build-home-runtime.cjs && node scripts/stage-vercel-public.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/news-page.js": {
      "includeFiles": "api/news-template.html"
    }
  },
  "headers": [
    {
      "source": "/push-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/push/"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/products",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sets/:setId",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/Js/dart-cache-recovery.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/Eye/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(cart-checkout|profile|Sign Up modern|track|rep|pdf).html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/Photos/me.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/Photos/me.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; script-src 'self' 'sha256-9+ERHNA1gKCB3GrC87slEUTusHlcvpnPBvHV4khGDrw=' 'sha256-9s+EyZLIEFaUqA3pJVOu+dIyGfHbloZuhpKUakl5nGs=' 'sha256-Nk6/GQoTRObNBp+ym6SAu43WDnne9FD+Mt+i7a3Cl+A=' 'sha256-RaxmHr1QP7LYBtK+QliED9R0uthgAox4X1hQiMoq1S8=' 'sha256-RfCAEUcbmr61BlBUMq3t8pS7Gg1KcsN4DhQxMnJe6AQ=' 'sha256-k8JcBMtf+6dhB5grWYB+5fkN1nNLE+i0HXYx+r7P844=' 'sha256-rWIkadooUgQrYPURYG/Y5osM0QxKqAxxSiKKKD4QALo=' 'inline-speculation-rules' 'sha256-Y7DedZ45D/0BFUtDI6Yaa8XBDXCsx/GLB7w1s5F5lbw=' 'sha256-/fLkpE7/LhcrMdne0F37Ua1Y9+vaIaIIyweWDrP7D+0=' https://cdn.jsdelivr.net https://unpkg.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: blob: https://unpkg.com https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://via.placeholder.com; connect-src 'self' https://nominatim.openstreetmap.org https://router.project-osrm.org; worker-src 'self'; manifest-src 'self'; media-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dart-project-psi.vercel.app"
        }
      ],
      "destination": "https://www.dartofficial.com/:path*",
      "permanent": true
    },
    {
      "source": "/Photos/me.webp",
      "destination": "/Photos/me.png?v=founder-png-v10",
      "permanent": false
    },
    {
      "source": "/products.html",
      "destination": "/products",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/news-sitemap"
    },
    {
      "source": "/news/:id/:slug",
      "destination": "/api/news-page?id=:id&slug=:slug"
    },
    {
      "source": "/news/:id",
      "destination": "/api/news-page?id=:id"
    },
    {
      "source": "/product-sitemap.xml",
      "destination": "https://dart-api-dusky.vercel.app/api/v1/catalog/sitemap.xml"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/products/:slug",
      "destination": "/api/product-page?slug=:slug"
    },
    {
      "source": "/sets/:setId",
      "destination": "/products.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://dart-api-dusky.vercel.app/api/:path*"
    }
  ]
}
