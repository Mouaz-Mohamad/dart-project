{
  "name": "@dart/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Server-authoritative API foundation for Dart | for you",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vitest.config.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/database.integration.test.ts",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts",
    "db:migrate:one": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts --one",
    "db:seed:dev": "node --env-file-if-exists=.env --import tsx src/database/seed.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
