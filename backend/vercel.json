{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/server.ts": {
      "maxDuration": 300,
      "includeFiles": "migrations/**"
    }
  },
  "buildCommand": "npm run build:release",
  "crons": [
    {
      "path": "/api/v1/internal/outbox/cron",
      "schedule": "*/5 * * * *"
    }
  ]
}
