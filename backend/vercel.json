{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-backend.sh",
  "functions": {
    "src/server.ts": {
      "includeFiles": "migrations/**"
    }
  },
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/v1/internal/outbox/process",
      "schedule": "17 3 * * *"
    }
  ]
}
