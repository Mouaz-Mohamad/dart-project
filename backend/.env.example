NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dart:dart_local_password@localhost:5432/dart
DATABASE_SSL=false
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:4173
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=info
ALLOW_DEVELOPMENT_SEED=false
AUTH_PEPPER=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=dart_session
# Use none only when the HTTPS frontend and API are on different sites, such as separate *.vercel.app domains.
SESSION_COOKIE_SAME_SITE=strict
SESSION_TTL_DAYS=30
EMAIL_OTP_TTL_MINUTES=10
# Exactly 32 random bytes encoded as Base64. Never expose this to the frontend.
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Customer social sign-in. Provider secrets are server-side only.
# API_PUBLIC_ORIGIN must match the OAuth callback origin registered with each provider.
API_PUBLIC_ORIGIN=http://localhost:4000
CUSTOMER_APP_ORIGIN=http://localhost:4173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
SOCIAL_AUTH_TTL_MINUTES=10

# Email delivery. Required for Dart Eye Staff email verification in production.
# For Gmail SMTP use smtp.gmail.com:587 with STARTTLS and an App Password.
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Dart | for you

# Optional operational monitoring alerts. Uses the same SMTP provider above.
# Repeated identical errors are suppressed for the cooldown period to avoid alert floods.
MONITORING_ALERT_EMAIL=
MONITORING_ALERT_COOLDOWN_MS=300000

# Direct WhatsApp Business Platform (Meta Cloud API). Keep these server-side only.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_OWNER_PHONE=
WHATSAPP_STAFF_OTP_TEMPLATE=dart_staff_otp
WHATSAPP_STAFF_INVITE_TEMPLATE=dart_staff_invite
OUTBOX_CRON_SECRET=
OUTBOX_BATCH_SIZE=20
