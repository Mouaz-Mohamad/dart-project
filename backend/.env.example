NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dart:dart_local_password@localhost:5432/dart
DATABASE_SSL=false
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:4173
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=info
ALLOW_DEVELOPMENT_SEED=false
AUTH_PEPPER=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=dart_session
# Use none only when the HTTPS frontend and API are on different sites, such as separate *.vercel.app domains.
SESSION_COOKIE_SAME_SITE=strict
SESSION_TTL_DAYS=30
EMAIL_OTP_TTL_MINUTES=10
# Exactly 32 random bytes encoded as Base64. Never expose this to the frontend.
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Dart Eye Staff identity. Supabase proves Google identity only; Dart sessions/RBAC remain authoritative.
# Keep legacy auth enabled during Phase 1 rollback testing. The legacy UI stays hidden unless explicitly enabled.
STAFF_GOOGLE_AUTH_ENABLED=false
STAFF_LEGACY_AUTH_ENABLED=true
STAFF_LEGACY_AUTH_UI_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_AUTH_TIMEOUT_MS=6000
GOOGLE_CLIENT_ID=
# No SUPABASE_SERVICE_ROLE_KEY is required for this flow. Never expose one to browser code.

# Direct WhatsApp Business Platform (Meta Cloud API). Keep these server-side only.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_OWNER_PHONE=
WHATSAPP_STAFF_OTP_TEMPLATE=dart_staff_otp
WHATSAPP_STAFF_INVITE_TEMPLATE=dart_staff_invite
OUTBOX_CRON_SECRET=
OUTBOX_BATCH_SIZE=20

# Phase-1 rollback only. The new Owner path is the protected Google allowlist seeded by migration 0024.
# Legacy bootstrap refuses every email except midomoaaz3@gmail.com and must not be used as the normal login setup.
DART_OWNER_NAME=Mouaz Mohamad
DART_OWNER_EMAIL=midomoaaz3@gmail.com
DART_OWNER_PHONE=01104193534
DART_OWNER_PASSWORD=

# Email delivery — values belong only in server environment settings.
STAFF_INVITE_OTP_TTL_HOURS=48
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Dart | for you
