NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dart:dart_local_password@localhost:5432/dart
DATABASE_SSL=false
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:4173
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=info
ALLOW_DEVELOPMENT_SEED=false
AUTH_PEPPER=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=dart_session
# Use none only when the HTTPS frontend and API are on different sites, such as separate *.vercel.app domains.
SESSION_COOKIE_SAME_SITE=strict
SESSION_TTL_DAYS=30
EMAIL_OTP_TTL_MINUTES=10
# Exactly 32 random bytes encoded as Base64. Never expose this to the frontend.
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Direct WhatsApp Business Platform (Meta Cloud API). Keep these server-side only.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_OWNER_PHONE=
WHATSAPP_STAFF_OTP_TEMPLATE=dart_staff_otp
WHATSAPP_STAFF_INVITE_TEMPLATE=dart_staff_invite
OUTBOX_CRON_SECRET=
OUTBOX_BATCH_SIZE=20

# Used only by `npm run admin:bootstrap-owner`; remove the password after the command succeeds.
DART_OWNER_NAME=
DART_OWNER_EMAIL=
DART_OWNER_PHONE=
DART_OWNER_PASSWORD=
